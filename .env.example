# Token broker that returns {"access_token":"..."}. Keep its URL in GitHub Secrets.
AMAZON_TOKEN_ENDPOINT=
AMAZON_ADS_CLIENT_ID=

# Feishu workflow webhook and its verification token.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_TOKEN=

# Optional operational settings.
DSP_ADVERTISER_NAME_PATTERN=AutoFull
DSP_HTTP_TIMEOUT_MS=30000
DSP_REPORT_POLL_MS=5000
DSP_REPORT_POLL_ATTEMPTS=36
DSP_FEISHU_WRITE_DELAY_MS=100
